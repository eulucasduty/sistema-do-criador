# Copie pra .env.local (no seu PC, pra estação de edição) ou cole na Vercel
# (Settings → Environment Variables). Nunca suba este arquivo preenchido pro GitHub.

# ── Supabase (Project Settings → API Keys) ──────────────────────
NEXT_PUBLIC_SUPABASE_URL=              # https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=  # pública (sb_publishable_...), vai pro navegador
SUPABASE_SECRET_KEY=                   # SECRETA (sb_secret_...), só no servidor e no seu PC

# ── IA (openrouter.ai → Keys) ───────────────────────────────────
OPENROUTER_API_KEY=                    # sk-or-...
AI_MODEL=                              # opcional: modelo que vê e ouve vídeo (padrão google/gemini-3.8-flash)
MODELO_CRIACAO=                        # opcional: modelo que escreve na sua voz (padrão anthropic/claude-sonnet-5)

# ── Instagram (o seu app na Meta) ───────────────────────────────
IG_WEBHOOK_VERIFY_TOKEN=               # uma senha qualquer; a mesma vai no webhook do app da Meta
META_APP_SECRET=                       # "Chave secreta do app do Instagram" (tela de configuração da API)

# ── Relógio ─────────────────────────────────────────────────────
CRON_SECRET=                           # uma senha qualquer; protege /api/relogio

# ── Só fora da Vercel ───────────────────────────────────────────
APP_URL=                               # endereço público com https (na Vercel vem sozinho)
RELOGIO=                               # "ligado" só em servidor próprio (Docker/VPS), no lugar do pg_cron

# ── Só na estação de edição (seu PC), se precisar ───────────────
# EDITOR_SAIDA=                        # pasta onde os vídeos prontos ficam (padrão: Vídeos/Sistema do Criador)
# CLAUDE_BIN= / FFMPEG_BIN= / WHISPER_BIN= / WHISPER_MODEL=   (veja editor/INSTALAR.md)
