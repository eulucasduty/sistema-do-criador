# Na Vercel você só precisa das 3 primeiras (Settings → Environment Variables).
# O resto (chave da IA, chave secreta do app da Meta) você cola dentro do sistema.
# Nunca suba este arquivo preenchido pro GitHub.

# ── Supabase (Project Settings → API Keys) ──────────────────────
NEXT_PUBLIC_SUPABASE_URL=              # https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=  # pública (sb_publishable_...), vai pro navegador
SUPABASE_SECRET_KEY=                   # SECRETA (sb_secret_...), só no servidor

# ── Opcionais (quem prefere variável a colar no painel) ─────────
# OPENROUTER_API_KEY=                  # sk-or-... (senão: Início → passo 2)
# META_APP_SECRET=                     # chave secreta do app da Meta (senão: Início → passo 4)
# IG_WEBHOOK_VERIFY_TOKEN=             # senão o sistema gera um (o Início mostra pra copiar)
# CRON_SECRET=                         # senão o sistema gera um
# AI_MODEL=                            # modelo que vê e ouve vídeo (padrão google/gemini-3.8-flash)
# MODELO_CRIACAO=                      # modelo que escreve na sua voz (padrão anthropic/claude-sonnet-5)

# ── Só fora da Vercel (Docker/VPS) ──────────────────────────────
# APP_URL=                             # endereço público com https
# RELOGIO=ligado                       # o relógio roda dentro do servidor, no lugar do pg_cron
